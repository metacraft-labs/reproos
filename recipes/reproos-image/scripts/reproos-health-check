#!/bin/bash
set -u

failures=0
status_dir=/var/lib/reproos
status_file="$status_dir/health-status"
mkdir -p "$status_dir"
: > "$status_file"

emit() {
  printf '%s\n' "$1" | tee -a "$status_file"
  if [[ -w /dev/ttyS0 ]]; then
    printf '%s\n' "$1" > /dev/ttyS0
  fi
}

pass() {
  emit "REPROOS_HEALTH:OK:$1"
}

fail() {
  emit "REPROOS_HEALTH:FAIL:$1"
  failures=$((failures + 1))
}

for artifact in auto-config.toml system.nim hardware.nim disko.json home.nim; do
  if [[ -s "/etc/repro/$artifact" ]]; then
    pass "artifact:$artifact"
  else
    fail "artifact:$artifact"
  fi
done

toml_string() {
  local wanted_section="$1"
  local wanted_key="$2"
  local current_section=''
  local line
  local prefix
  local value

  prefix="$wanted_key = \""
  while IFS= read -r line; do
    if [[ "$line" == \[*\] ]]; then
      current_section="${line#\[}"
      current_section="${current_section%\]}"
      continue
    fi
    if [[ "$current_section" == "$wanted_section" &&
          "$line" == "$prefix"* && "$line" == *\" ]]; then
      value="${line#"$prefix"}"
      printf '%s\n' "${value%\"}"
      return 0
    fi
  done < /etc/repro/auto-config.toml
  return 1
}

expected_hostname="$(toml_string '' hostname || true)"
actual_hostname="$(cat /etc/hostname 2>/dev/null || true)"
if [[ -n "$expected_hostname" && "$actual_hostname" == "$expected_hostname" ]]; then
  pass "hostname:$actual_hostname"
else
  fail "hostname:expected=$expected_hostname:actual=$actual_hostname"
fi

expected_user="$(toml_string user name || true)"
expected_full_name="$(toml_string user full_name || true)"
expected_shell="$(toml_string user shell || true)"
user_record_found=0
while IFS=: read -r account_name _ account_uid account_gid account_gecos \
    account_home account_shell; do
  if [[ "$account_name" == "$expected_user" &&
        "$account_uid" == 1000 && "$account_gid" == 1000 &&
        "$account_gecos" == "$expected_full_name" &&
        "$account_home" == "/home/$expected_user" &&
        "$account_shell" == "$expected_shell" ]]; then
    user_record_found=1
    break
  fi
done < /etc/passwd
if [[ -n "$expected_user" && "$user_record_found" == 1 ]]; then
  pass "user:$expected_user"
else
  fail "user:$expected_user"
fi

expected_groups="$({
  awk '
    BEGIN { section="" }
    /^[[:space:]]*\[/ {
      section=$0
      gsub(/^[[:space:]]*\[|\][[:space:]]*$/, "", section)
      next
    }
    section == "user" && /^[[:space:]]*groups[[:space:]]*=/ {
      value=$0
      sub(/^[^=]*=/, "", value)
      gsub(/[\[\]",]/, " ", value)
      print value
      exit
    }
  ' /etc/repro/auto-config.toml
} || true)"
for expected_group in $expected_groups; do
  if awk -F: -v wanted_group="$expected_group" -v wanted_user="$expected_user" '
    $1 == wanted_group {
      count=split($4, members, ",")
      for (i=1; i<=count; i++) if (members[i] == wanted_user) found=1
    }
    END { exit(found ? 0 : 1) }
  ' /etc/group; then
    pass "group:$expected_group:$expected_user"
  else
    fail "group:$expected_group:$expected_user"
  fi
done

duplicate_group_ids="$(awk -F: '
  $3 ~ /^[0-9]+$/ { count[$3]++; names[$3]=(names[$3] ? names[$3] "," $1 : $1) }
  END { for (gid in count) if (count[gid] > 1) print gid ":" names[gid] }
' /etc/group)"
if [[ -z "$duplicate_group_ids" ]]; then
  pass "groups:unique-gids"
else
  fail "groups:duplicate-gids=$duplicate_group_ids"
fi

if touch "$status_dir/root-write-check" && rm -f "$status_dir/root-write-check"; then
  pass "root-filesystem:writable"
else
  fail "root-filesystem:read-only"
fi

if systemctl is-active --quiet graphical.target; then
  pass "target:graphical"
else
  fail "target:graphical"
fi

if systemctl is-active --quiet sddm.service; then
  pass "service:sddm"
else
  fail "service:sddm"
fi

if systemctl is-active --quiet seatd.service; then
  pass "service:seatd"
else
  fail "service:seatd"
fi

if [[ -s /usr/share/wayland-sessions/sway.desktop ]]; then
  pass "session:sway-desktop-entry"
else
  fail "session:sway-desktop-entry"
fi

session_ready=0
for _ in $(seq 1 90); do
  if pgrep -x sway >/dev/null 2>&1; then
    session_ready=1
    break
  fi
  sleep 1
done
if [[ "$session_ready" == 1 ]]; then
  pass "session:sway-running"
else
  fail "session:sway-running"
fi

mapfile -t failed_units < <(
  systemctl --failed --no-legend --plain 2>/dev/null | awk '{print $1}'
)
if [[ ${#failed_units[@]} -eq 0 ]]; then
  pass "systemd:no-failed-units"
else
  fail "systemd:failed-units=${failed_units[*]}"
fi

mapfile -t ordering_cycles < <(
  journalctl -b --no-pager 2>/dev/null | grep 'Found ordering cycle' || true
)
if [[ ${#ordering_cycles[@]} -eq 0 ]]; then
  pass "systemd:no-ordering-cycles"
else
  fail "systemd:ordering-cycles=${#ordering_cycles[@]}"
fi

if [[ "$failures" -eq 0 ]]; then
  emit "REPROOS_HEALTH:PASS"
  exit 0
fi

emit "REPROOS_HEALTH:FAILED:$failures"
exit 1
