#!/usr/bin/busybox sh
set -eu

root=${REPROOS_ROOT:-}
state="$root/var/lib/reproos"
complete="$state/enrollment.complete"
mountpoint="$root/run/reproos-enrollment"
enrollment=${REPROOS_ENROLLMENT_DIR:-}
mounted=0

cleanup() {
  if [ "$mounted" = 1 ]; then
    umount "$mountpoint" 2>/dev/null || true
  fi
}
trap cleanup EXIT INT TERM

[ -f "$complete" ] && exit 0
mkdir -p "$state" "$mountpoint"

if [ -z "$enrollment" ]; then
  for device in /dev/disk/by-label/REPROOS_ENROLL /dev/sr1 /dev/sr0; do
    [ -e "$device" ] || continue
    if mount -o ro "$device" "$mountpoint" 2>/dev/null; then
      enrollment=$mountpoint
      mounted=1
      break
    fi
  done
fi

if [ -z "$enrollment" ] || [ ! -f "$enrollment/machine-id" ] || \
   [ ! -f "$enrollment/authorized_keys" ]; then
  echo "REPROOS_ENROLLMENT:FAIL:media-not-found" >&2
  exit 1
fi

machine_id=$(tr -d '\r\n-' < "$enrollment/machine-id")
case "$machine_id" in
  *[!0-9a-fA-F]*|'')
    echo "REPROOS_ENROLLMENT:FAIL:invalid-machine-id" >&2
    exit 1
    ;;
esac
[ "${#machine_id}" = 32 ] || {
  echo "REPROOS_ENROLLMENT:FAIL:invalid-machine-id" >&2
  exit 1
}

if grep -q 'PRIVATE KEY' "$enrollment/authorized_keys" || \
   ! awk '
      NF == 0 { next }
      $1 !~ /^(ssh-ed25519|ecdsa-sha2-nistp(256|384|521)|sk-ssh-ed25519@openssh.com|sk-ecdsa-sha2-nistp256@openssh.com)$/ { exit 1 }
      NF < 2 { exit 1 }
      { found=1 }
      END { exit(found ? 0 : 1) }
    ' "$enrollment/authorized_keys"; then
  echo "REPROOS_ENROLLMENT:FAIL:invalid-authorized-keys" >&2
  exit 1
fi

config="$root/etc/repro/auto-config.toml"
user=$(awk '
  BEGIN { section="" }
  /^\[/ { section=$0; gsub(/^\[|\]$/, "", section); next }
  section == "user" && /^[[:space:]]*name[[:space:]]*=/ {
    value=$0; sub(/^[^=]*=[[:space:]]*/, "", value); gsub(/^"|"$/, "", value)
    print value; exit
  }
' "$config")
case "$user" in
  ''|*[!a-zA-Z0-9_-]*)
    echo "REPROOS_ENROLLMENT:FAIL:invalid-user" >&2
    exit 1
    ;;
esac

full_name=$(awk '
  BEGIN { section="" }
  /^\[/ { section=$0; gsub(/^\[|\]$/, "", section); next }
  section == "user" && /^[[:space:]]*full_name[[:space:]]*=/ {
    value=$0; sub(/^[^=]*=[[:space:]]*/, "", value); gsub(/^"|"$/, "", value)
    print value; exit
  }
' "$config")
shell=$(awk '
  BEGIN { section="" }
  /^\[/ { section=$0; gsub(/^\[|\]$/, "", section); next }
  section == "user" && /^[[:space:]]*shell[[:space:]]*=/ {
    value=$0; sub(/^[^=]*=[[:space:]]*/, "", value); gsub(/^"|"$/, "", value)
    print value; exit
  }
' "$config")
configured_hostname=$(awk '
  BEGIN { section="" }
  /^\[/ { section=$0; gsub(/^\[|\]$/, "", section); next }
  section == "" && /^[[:space:]]*hostname[[:space:]]*=/ {
    value=$0; sub(/^[^=]*=[[:space:]]*/, "", value); gsub(/^"|"$/, "", value)
    print value; exit
  }
' "$config")
groups=$(awk '
  BEGIN { section="" }
  /^\[/ { section=$0; gsub(/^\[|\]$/, "", section); next }
  section == "user" && /^[[:space:]]*groups[[:space:]]*=/ {
    value=$0; sub(/^[^=]*=/, "", value); gsub(/[\[\]",]/, " ", value)
    gsub(/[[:space:]]+/, " ", value); sub(/^ /, "", value); sub(/ $/, "", value)
    print value; exit
  }
' "$config")
groups="$groups seat"
[ -n "$full_name" ] || full_name=$user
[ -n "$shell" ] || shell=/bin/bash
case "$configured_hostname" in
  ''|*[!a-zA-Z0-9.-]*)
    echo "REPROOS_ENROLLMENT:FAIL:invalid-hostname" >&2
    exit 1
    ;;
esac

gid_in_use() {
  awk -F: -v wanted="$1" '$3 == wanted { found=1 } END { exit(found ? 0 : 1) }' \
    "$root/etc/group"
}

ensure_group() {
  group_name=$1
  preferred_gid=$2
  grep -q "^$group_name:" "$root/etc/group" && return 0
  gid=$preferred_gid
  if gid_in_use "$gid"; then
    gid=200
    while gid_in_use "$gid"; do
      gid=$((gid + 1))
    done
  fi
  printf '%s:x:%s:\n' "$group_name" "$gid" >> "$root/etc/group"
}

for group_name in $groups; do
  case "$group_name" in
    ''|*[!a-zA-Z0-9_-]*)
      echo "REPROOS_ENROLLMENT:FAIL:invalid-group" >&2
      exit 1
      ;;
    wheel) preferred_gid=10 ;;
    audio) preferred_gid=29 ;;
    video) preferred_gid=44 ;;
    networkmanager) preferred_gid=102 ;;
    seat) preferred_gid=985 ;;
    *) preferred_gid=200 ;;
  esac
  ensure_group "$group_name" "$preferred_gid"
done

if ! grep -q "^$user:" "$root/etc/passwd"; then
  awk -F: -v user="$user" '$1 != user && $1 != "live"' \
    "$root/etc/passwd" > "$state/passwd.new"
  printf '%s:x:1000:1000:%s:/home/%s:%s\n' \
    "$user" "$full_name" "$user" "$shell" >> "$state/passwd.new"
  install -m 0644 "$state/passwd.new" "$root/etc/passwd"

  awk -F: -v user="$user" '$1 != user && $1 != "live"' \
    "$root/etc/shadow" > "$state/shadow.new"
  # Keep the password unusable without locking the account itself. OpenSSH
  # rejects a leading ! or * before attempting public-key authentication when
  # UsePAM is disabled; "x" cannot validate as a crypt hash and password login
  # is disabled in sshd_config.
  printf '%s:x:20000:0:99999:7:::\n' "$user" >> "$state/shadow.new"
  install -m 0600 "$state/shadow.new" "$root/etc/shadow"

fi

# Reconcile memberships on every attempt so a partially completed enrollment
# remains recoverable. Missing configured groups were created above with stable
# preferred GIDs; the private seat group is an implementation requirement for
# the source-built seatd service and is not part of the public user profile.
awk -F: -v OFS=: -v user="$user" -v wanted="$groups" '
  $1 == user || $1 == "live" { next }
  {
    members=""
    count=split($4, old, ",")
    for (i=1; i<=count; i++)
      if (old[i] != "" && old[i] != "live" && old[i] != user)
        members=members (members == "" ? "" : ",") old[i]
    if (index(" " wanted " ", " " $1 " ") > 0)
      members=members (members == "" ? "" : ",") user
    $4=members
    print
  }
  END { print user, "x", "1000", "" }
' "$root/etc/group" > "$state/group.new"
install -m 0644 "$state/group.new" "$root/etc/group"

# Keep the shadow group database aligned with /etc/group. In particular, remove
# the live installer identity and add the configured user to every requested
# supplemental group, including groups created during this enrollment.
awk -F: -v OFS=: -v user="$user" -v wanted="$groups" '
  function filtered_members(value, include_user, result, count, old, i) {
    result=""
    count=split(value, old, ",")
    for (i=1; i<=count; i++)
      if (old[i] != "" && old[i] != "live" && old[i] != user)
        result=result (result == "" ? "" : ",") old[i]
    if (include_user)
      result=result (result == "" ? "" : ",") user
    return result
  }
  $1 == user || $1 == "live" { next }
  {
    seen[$1]=1
    $3=filtered_members($3, 0)
    $4=filtered_members($4, index(" " wanted " ", " " $1 " ") > 0)
    print
  }
  END {
    count=split(wanted, requested, " ")
    for (i=1; i<=count; i++)
      if (requested[i] != "" && !seen[requested[i]])
        print requested[i], "!", "", user
    print user, "!", "", ""
  }
' "$root/etc/gshadow" > "$state/gshadow.new"
install -m 0640 "$state/gshadow.new" "$root/etc/gshadow"

home="$root/home/$user"
ssh_dir="$home/.ssh"
mkdir -p "$ssh_dir" "$root/etc/ssh"
chmod 0750 "$home"
install -m 0600 "$enrollment/authorized_keys" "$ssh_dir/authorized_keys"
printf '%s\n' "$machine_id" > "$root/etc/machine-id"
chmod 0644 "$root/etc/machine-id"
if [ "${REPROOS_TEST_MODE:-0}" != 1 ]; then
  chown -R "$user:$user" "$home"
fi

# The live root is also the installation source. Convert its installer login
# into the configured installed-system session before the display manager
# starts, and make the transition durable across subsequent boots.
printf '%s\n' "$configured_hostname" > "$root/etc/hostname"
mkdir -p "$root/etc/sddm.conf.d"
cat > "$root/etc/sddm.conf.d/00-autologin.conf" <<EOF
[Autologin]
User=$user
Session=sway
Relogin=false

[General]
HaltCommand=/usr/bin/systemctl poweroff
RebootCommand=/usr/bin/systemctl reboot
EOF
if [ -f "$root/etc/reproos/auto-config.toml" ]; then
  mv "$root/etc/reproos/auto-config.toml" \
    "$root/etc/reproos/auto-config.toml.disabled-after-install"
fi
mkdir -p "$root/etc/sudoers.d"
printf '%s ALL=(ALL) NOPASSWD: ALL\n' "$user" > "$root/etc/sudoers.d/90-reproos-user"
chmod 0440 "$root/etc/sudoers.d/90-reproos-user"

fingerprint=${REPROOS_SSH_HOST_KEY_FINGERPRINT:-}
if [ -z "$fingerprint" ]; then
  /usr/bin/ssh-keygen -A
  fingerprint=$(/usr/bin/ssh-keygen -lf \
    "$root/etc/ssh/ssh_host_ed25519_key.pub" -E sha256 | awk '{print $2}')
fi
case "$fingerprint" in
  SHA256:*) ;;
  *)
    echo "REPROOS_ENROLLMENT:FAIL:invalid-host-key-fingerprint" >&2
    exit 1
    ;;
esac

printf '%s\n' "$fingerprint" > "$state/ssh-host-key-fingerprint"
chmod 0644 "$state/ssh-host-key-fingerprint"

generation=$(cat "$root/etc/repro/generation")
install_source=$(cat "$state/install-source")
cat > "$state/identity.json" <<EOF
{
  "machine_id": "$machine_id",
  "generation_id": "$generation",
  "ssh_host_key_fingerprint": "$fingerprint",
  "install_source": "$install_source"
}
EOF
chmod 0644 "$state/identity.json"
touch "$complete"
echo "REPROOS_ENROLLMENT:PASS:machine_id=$machine_id"
