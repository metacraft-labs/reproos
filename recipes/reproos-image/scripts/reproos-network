#!/usr/bin/busybox sh
set -eu

ready_file=${REPROOS_NETWORK_READY_FILE:-/run/reproos-network-ready}
rm -f "$ready_file"
network_root=${REPROOS_SYS_CLASS_NET:-/sys/class/net}
attempt_limit=${REPROOS_NETWORK_INTERFACE_ATTEMPTS:-5}
interface=""
attempt=0
while [ "$attempt" -lt "$attempt_limit" ] && [ -z "$interface" ]; do
  for path in "$network_root"/*; do
    [ -e "$path" ] || continue
    candidate="${path##*/}"
    [ "$candidate" = "lo" ] && continue
    interface="$candidate"
    break
  done
  [ -n "$interface" ] || /usr/bin/busybox sleep 1
  attempt=$((attempt + 1))
done

if [ -z "$interface" ]; then
  echo "ReproOS network interface not found; continuing offline"
  printf 'offline\n' > "$ready_file"
  exit 0
fi

exec /usr/bin/busybox udhcpc -f -i "$interface" \
  -s /usr/local/sbin/reproos-udhcpc-hook
