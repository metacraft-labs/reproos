#!/bin/sh
# M9.R.51 - Boot-from-disk init for reproos-image build-artifact qcow2s.
#
# Simpler sibling of initramfs/init (the live-boot squashfs pivot).
# Parses `root=UUID=<uuid>` (or LABEL/PARTUUID/device) from /proc/cmdline, mounts that ext4
# partition at /newroot, switches root into it, execs /sbin/init.
# `UUID=` and `LABEL=` name a filesystem and are resolved by BusyBox
# findfs. `PARTUUID=` names a partition, which findfs cannot resolve, so
# this script reads it off the partition table itself (GPT, and the MBR
# `<disk signature>-<partition number>` form the kernel also accepts).
#
# It boots two shapes of root, and which one is chosen is decided by the
# kernel command line alone:
#
#   * A PLAIN root. `root=<spec>` names an ext4 partition, which is
#     mounted read-only and switched into. Nothing checks its contents.
#
#   * An INTEGRITY-CHECKED root. `reproos.verity.roothash=<hex>` names
#     the expected root hash of a dm-verity Merkle tree, and
#     `reproos.verity.data=` / `reproos.verity.hash=` name the image and
#     the tree that backs it. Every block read from that root is checked
#     against the tree on the way out of the block layer; a block that
#     does not match fails the read rather than being served. Writable
#     state lives on separate volumes named by `reproos.state.var=` and
#     `reproos.state.home=`, so nothing writable is ever part of what the
#     root hash covers.
#
# The root hash is a value the boot path supplies from outside the disk.
# That is the whole point of it: an attacker who can rewrite the root
# filesystem cannot also rewrite the hash it is checked against, so the
# worst they can achieve is a boot that stops.
#
# Designed for the BUSYBOX-only userspace that build-initramfs.sh
# stages (same busybox binary + slimmed Debian kernel modules). Every
# binary referenced below is a busybox applet, with one exception:
# `veritysetup`, which build-initramfs.sh stages next to busybox when the
# initramfs is built for an integrity-checked root, and whose absence is
# a hard failure rather than a fallback.

set -e

INIT_VERSION='M9.R.51-verity-root'

log() {
  echo "[disk-init] $*" >/dev/kmsg 2>/dev/null || echo "[disk-init] $*"
}

rescue() {
  log "FATAL: $*"
  # No shell on an integrity-checked root. That layout is the attested
  # one, and its console belongs to whoever runs the machine: the cloud
  # operator, or on a confidential VM the very host the attestation is
  # meant to exclude. A root shell offered here would run under the
  # launch measurement the verifier accepts -- and the failures that lead
  # here (a withheld hash device, a kernel that ignored lockdown=) are
  # ones such a host can cause. PID 1 exiting panics the kernel instead,
  # which stops the boot without handing anyone the measured machine. The
  # plain layout keeps its recovery shell.
  if [ -n "$VERITY_ROOTHASH" ]; then
    log "integrity-checked root: no rescue shell; stopping the boot"
    trap - EXIT
    exit 1
  fi
  log "dropping to busybox shell - use 'exit' to panic"
  exec /bin/sh
}

trap 'rescue "trap fired before reaching switch_root"' EXIT

log "starting $INIT_VERSION"

mkdir -p /proc /sys /dev /run /tmp /newroot
mount -t proc     none /proc
mount -t sysfs    none /sys
mount -t devtmpfs none /dev || true
mount -t tmpfs    none /run
mount -t tmpfs    none /tmp

# Parse kernel cmdline for root= and (optional) rootfstype=.
#
# The verity keys below are the ones repro/verity.nim declares. When
# reproos.verity.roothash= is present the root is an integrity-checked
# read-only image and `root=` is not needed: the root device is the
# device-mapper node this script creates. The state volumes are named
# separately so they can be mounted read-write without ever being part
# of the measured surface.
ROOT_SPEC=''
ROOT_FSTYPE='ext4'
DISK_DEBUG=''
VERITY_ROOTHASH=''
VERITY_DATA=''
VERITY_HASH=''
STATE_VAR=''
STATE_HOME=''
for arg in $(cat /proc/cmdline); do
  case "$arg" in
    root=*)                     ROOT_SPEC="${arg#root=}" ;;
    rootfstype=*)               ROOT_FSTYPE="${arg#rootfstype=}" ;;
    disk.debug)                 DISK_DEBUG=1 ;;
    reproos.verity.roothash=*)  VERITY_ROOTHASH="${arg#reproos.verity.roothash=}" ;;
    reproos.verity.data=*)      VERITY_DATA="${arg#reproos.verity.data=}" ;;
    reproos.verity.hash=*)      VERITY_HASH="${arg#reproos.verity.hash=}" ;;
    reproos.state.var=*)        STATE_VAR="${arg#reproos.state.var=}" ;;
    reproos.state.home=*)       STATE_HOME="${arg#reproos.state.home=}" ;;
  esac
done

VERITY_NAME='reproos-root'

if [ -n "$VERITY_ROOTHASH" ]; then
  log "verity roothash=$VERITY_ROOTHASH data=$VERITY_DATA hash=$VERITY_HASH"
elif [ -z "$ROOT_SPEC" ]; then
  rescue "no root= and no reproos.verity.roothash= on kernel cmdline"
else
  log "root=$ROOT_SPEC rootfstype=$ROOT_FSTYPE"
fi

# Load modules. Same set as live-init but trimmed to what a
# disk boot on QEMU/virtio needs (no cdrom / iso9660 / squashfs /
# overlay / loop).
#
# A driver that is compiled INTO the kernel has no .ko to load, and
# `modprobe` on it fails exactly the way a genuinely missing driver
# does. Consult the kernel's own modules.builtin (staged by
# build-initramfs.sh) first, so "already in the kernel" is never
# reported as "missing" - dm_verity and the TPM drivers are built in on
# the source-built kernel, and the boot log is the only place this is
# visible.
MODULE_ROOT="/lib/modules/$(uname -r)"
BUILTIN_LIST="$MODULE_ROOT/modules.builtin"

is_builtin() {
  [ -f "$BUILTIN_LIST" ] || return 1
  _u="$(echo "$1" | tr '-' '_')"
  _d="$(echo "$1" | tr '_' '-')"
  grep -q -e "/${_u}\.ko" -e "/${_d}\.ko" "$BUILTIN_LIST"
}

load_module() {
  if is_builtin "$1"; then
    log "module $1 builtin"
    return 0
  fi
  modprobe "$1" 2>/dev/null && log "modprobe $1 ok" || log "modprobe $1 missing/failed (ok)"
}

log "loading kernel modules"
load_module virtio
load_module virtio_ring
load_module virtio_pci
load_module virtio_pci_modern_dev
load_module virtio_pci_legacy_dev
load_module virtio_blk
load_module virtio_scsi
load_module scsi_mod
load_module sd_mod
load_module ata_piix
load_module ahci
load_module nvme
load_module nvme_core
# crc32c BEFORE ext4 - ext4 mount fails without it.
load_module crc32c_generic
load_module crc32c-intel
load_module dm_mod
load_module dm_bufio
load_module dm_crypt
# dm_verity backs the integrity-checked read-only root; it must be live
# before the root filesystem is set up, which is here and nowhere later.
load_module dm_verity
# TPM. tpm_tis_core carries the TIS transport tpm_tis registers against;
# tpm_crb is the ACPI CRB alternative some firmware TPMs present.
load_module tpm
load_module tpm_tis_core
load_module tpm_tis
load_module tpm_crb
load_module ext4
load_module vfat
load_module nls_cp437
load_module nls_utf8
load_module nls_ascii
load_module drm
load_module drm_kms_helper
load_module virtio-gpu
load_module qxl
load_module bochs

# Let devtmpfs settle.
sleep 1

if [ -n "$DISK_DEBUG" ]; then
  log "disk.debug set - shell drop"
  trap - EXIT
  /bin/sh
  trap 'rescue "post-debug-shell trap"' EXIT
fi

# Resolve stable identifiers by scanning the block devices. The initramfs
# has devtmpfs but no udev daemon, so /dev/disk/by-* symlinks are not
# guaranteed to exist.
#
# `UUID=` and `LABEL=` name a FILESYSTEM. BusyBox findfs probes the
# superblocks itself and works on QEMU, Hyper-V and physical disk naming
# alike.
#
# `PARTUUID=` names a PARTITION, and findfs cannot resolve it: BusyBox's
# findfs hands everything that is not a /dev path to resolve_mount_spec,
# which handles LABEL= and UUID= and nothing else, and its volume_id code
# never reads a partition table. The kernel does not help either: the
# PARTUUID uevent variable only exists from Linux 6.13 on, and the ReproOS
# kernel is older. So the partition table is read here, the same way the
# kernel's own block/partitions code reads it. This is the attested boot
# path -- the verity data and hash carriers are named ONLY by PARTUUID
# (they carry no filesystem to probe) -- so it must not depend on a tool
# that silently lacks it.

# read_hex <device> <byte offset> <length>: the bytes as lowercase hex, in
# disk order, with no separators. Empty when the read comes up short.
#
# Every helper below returns 0 unless it says otherwise and reports
# failure by printing nothing: this script runs under `set -e`, and a
# failing command substitution on the right of an assignment would end
# the whole init rather than just this lookup.
read_hex() {
  _rh_skip=$(($2 / 512))
  _rh_in=$(($2 % 512))
  _rh_blocks=$(((_rh_in + $3 + 511) / 512))
  _rh_out="$(dd if="$1" bs=512 skip="$_rh_skip" count="$_rh_blocks" 2>/dev/null \
    | od -An -v -tx1 -j "$_rh_in" -N "$3" | tr -d ' \n')"
  if [ "${#_rh_out}" -eq $(($3 * 2)) ]; then
    echo "$_rh_out"
  fi
}

# reverse_hex <hex>: the bytes in reverse order, so a little-endian field
# reads as the number it encodes.
reverse_hex() {
  _rv_in="$1"
  _rv_out=''
  while [ -n "$_rv_in" ]; do
    _rv_out="$_rv_out${_rv_in#"${_rv_in%??}"}"
    _rv_in="${_rv_in%??}"
  done
  echo "$_rv_out"
}

# le_int <hex>: a little-endian field as an integer.
le_int() {
  echo $((0x$(reverse_hex "$1")))
}

# gpt_partuuid <disk device> <partition number> <logical block size>
#              <partition start in 512-byte sectors>
#
# The unique partition GUID of entry <partition number> -- the kernel
# numbers a GPT partition by its entry index plus one, holes included --
# formatted the way the kernel formats PARTUUID: the first three fields
# are stored little-endian, the last two as bytes (UEFI 2.10 section 5.3,
# "GPT Header" and "GPT Partition Entry Array"; Appendix A for the GUID
# text form).
#
# Only the primary header at LBA 1 is read. Without the `gpt` kernel
# parameter the kernel uses no other: a disk whose primary header is
# invalid has no partitions at all (block/partitions/efi.c,
# find_valid_gpt). The entry is accepted only if it starts where the
# kernel says the partition starts, so a table the kernel did NOT use (a
# backup it fell back to under `gpt`) resolves to nothing rather than to
# a guess.
gpt_partuuid() {
  _gp_disk="$1"; _gp_num="$2"; _gp_lbs="$3"; _gp_start="$4"
  _gp_hdr="$(read_hex "$_gp_disk" "$_gp_lbs" 92)"
  [ -n "$_gp_hdr" ] || return 1
  # "EFI PART"
  [ "$(echo "$_gp_hdr" | cut -c1-16)" = 4546492050415254 ] || return 1
  _gp_entries_lba="$(le_int "$(echo "$_gp_hdr" | cut -c145-160)")"
  _gp_count="$(le_int "$(echo "$_gp_hdr" | cut -c161-168)")"
  _gp_size="$(le_int "$(echo "$_gp_hdr" | cut -c169-176)")"
  [ "$_gp_num" -ge 1 ] && [ "$_gp_num" -le "$_gp_count" ] || return 1
  [ "$_gp_size" -ge 128 ] || return 1
  _gp_entry="$(read_hex "$_gp_disk" \
    $((_gp_entries_lba * _gp_lbs + (_gp_num - 1) * _gp_size)) 40)"
  [ -n "$_gp_entry" ] || return 1
  _gp_first="$(le_int "$(echo "$_gp_entry" | cut -c65-80)")"
  [ $((_gp_first * _gp_lbs / 512)) -eq "$_gp_start" ] || return 1
  _gp_guid="$(echo "$_gp_entry" | cut -c33-64)"
  echo "$(reverse_hex "$(echo "$_gp_guid" | cut -c1-8)")-$(reverse_hex "$(echo "$_gp_guid" | cut -c9-12)")-$(reverse_hex "$(echo "$_gp_guid" | cut -c13-16)")-$(echo "$_gp_guid" | cut -c17-20)-$(echo "$_gp_guid" | cut -c21-32)"
}

# partition_partuuid <partition's /sys/class/block entry>: its PARTUUID as
# the kernel would spell it, or nothing when it cannot be determined.
partition_partuuid() {
  _pp_sys="$1"
  _pp_num="$(cat "$_pp_sys/partition" 2>/dev/null)" || return 1
  _pp_start="$(cat "$_pp_sys/start" 2>/dev/null)" || return 1
  # A partition's sysfs directory sits inside its disk's.
  _pp_disk_sys="$(readlink -f "$_pp_sys")/.."
  _pp_disk="/dev/$(sed -n 's/^DEVNAME=//p' "$_pp_disk_sys/uevent")"
  [ -b "$_pp_disk" ] || return 1
  _pp_lbs="$(cat "$_pp_disk_sys/queue/logical_block_size" 2>/dev/null || echo 512)"
  _pp_mbr="$(read_hex "$_pp_disk" 440 72)"
  [ -n "$_pp_mbr" ] || return 1
  # Boot signature 0x55AA, then the four primary entries' types. A type
  # 0xEE entry in any of them marks a protective (or hybrid) MBR in front
  # of a GPT, which is how the kernel decides the disk is GPT
  # (block/partitions/efi.c, is_pmbr_valid).
  [ "$(echo "$_pp_mbr" | cut -c141-144)" = 55aa ] || return 1
  _pp_types="$(echo "$_pp_mbr" | cut -c21-22) $(echo "$_pp_mbr" | cut -c53-54) $(echo "$_pp_mbr" | cut -c85-86) $(echo "$_pp_mbr" | cut -c117-118)"
  if [ "${_pp_types#*ee}" != "$_pp_types" ]; then
    gpt_partuuid "$_pp_disk" "$_pp_num" "$_pp_lbs" "$_pp_start"
  else
    # An MBR disk: the kernel spells it <disk signature>-<partition number>,
    # both in lowercase hex (block/partitions/msdos.c).
    printf '%s-%02x\n' "$(reverse_hex "$(echo "$_pp_mbr" | cut -c1-8)")" "$_pp_num"
  fi
}

# resolve_partuuid <uuid>: the one partition carrying it. Two partitions
# carrying the same PARTUUID resolve to NOTHING: picking one would let
# whichever disk enumerates first decide what is mounted, and on the
# attested path the specifier is the only thing naming the device.
resolve_partuuid() {
  _rp_want="$(echo "$1" | tr 'A-F' 'a-f')"
  _rp_found=''
  for _rp_sys in /sys/class/block/*; do
    [ -e "$_rp_sys/partition" ] || continue
    _rp_have="$(partition_partuuid "$_rp_sys" 2>/dev/null)" || continue
    [ "$_rp_have" = "$_rp_want" ] || continue
    _rp_dev="/dev/$(sed -n 's/^DEVNAME=//p' "$_rp_sys/uevent")"
    if [ -n "$_rp_found" ]; then
      # To stderr: this runs inside a command substitution, and log's
      # fallback when /dev/kmsg is unwritable is stdout, which would
      # turn the message into the "device" this lookup returns.
      log "PARTUUID=$1 is on both $_rp_found and $_rp_dev; refusing to choose" >&2
      return 0
    fi
    _rp_found="$_rp_dev"
  done
  if [ -n "$_rp_found" ]; then
    echo "$_rp_found"
  fi
}

resolve_spec() {
  case "$1" in
    PARTUUID=*)     resolve_partuuid "${1#PARTUUID=}" || true ;;
    UUID=*|LABEL=*) findfs "$1" 2>/dev/null || true ;;
    *)              echo "$1" ;;
  esac
}

# Wait for a block device to appear. Re-resolve stable identifiers on every
# iteration because the disk may be attached after the first scan.
await_device() {
  # await_device <spec> <what it is, for the diagnostic>
  _spec="$1"
  _what="$2"
  _dev=''
  _attempt=0
  while :; do
    _dev="$(resolve_spec "$_spec")"
    if [ -n "$_dev" ] && [ -b "$_dev" ]; then
      echo "$_dev"
      return 0
    fi
    _attempt=$((_attempt + 1))
    if [ "$_attempt" -ge 30 ]; then
      log "$_what $_spec never appeared; last resolution: ${_dev:-<none>}; available:"
      ls /sys/class/block/ >/dev/kmsg 2>/dev/null || ls /sys/class/block/
      rescue "$_what not found"
    fi
    sleep 1
  done
}

if [ -n "$VERITY_ROOTHASH" ]; then
  # The integrity-checked read-only root.
  #
  # There is deliberately NO fallback. If the hash tree is missing, the
  # tool is missing, or the root hash does not match, this boot stops.
  # Mounting the data device directly would produce a system that looks
  # identical and serves whatever bytes are on the disk -- which is the
  # exact failure the read-only root exists to make impossible.
  if [ -z "$VERITY_DATA" ] || [ -z "$VERITY_HASH" ]; then
    rescue "reproos.verity.roothash= given without reproos.verity.data= and reproos.verity.hash="
  fi
  if ! command -v veritysetup >/dev/null 2>&1; then
    rescue "veritysetup is not in this initramfs; an integrity-checked root cannot be activated without it"
  fi
  VERITY_DATA_DEV="$(await_device "$VERITY_DATA" 'verity data device')"
  VERITY_HASH_DEV="$(await_device "$VERITY_HASH" 'verity hash device')"
  log "veritysetup open $VERITY_DATA_DEV $VERITY_NAME $VERITY_HASH_DEV"
  # No udev runs in an initramfs, so libdevmapper must create the node
  # itself rather than wait for a uevent that will never be answered.
  if ! DM_DISABLE_UDEV=1 veritysetup open \
      "$VERITY_DATA_DEV" "$VERITY_NAME" "$VERITY_HASH_DEV" \
      "$VERITY_ROOTHASH"; then
    rescue "verity activation failed - the root filesystem does not match $VERITY_ROOTHASH"
  fi
  ROOT_DEV="/dev/mapper/$VERITY_NAME"
  if [ ! -b "$ROOT_DEV" ]; then
    rescue "verity reported success but $ROOT_DEV does not exist"
  fi
  log "verity active: $ROOT_DEV"
else
  ROOT_DEV="$(await_device "$ROOT_SPEC" 'root device')"
fi

log "mounting $ROOT_DEV at /newroot"
if ! mount -t "$ROOT_FSTYPE" -o ro "$ROOT_DEV" /newroot; then
  rescue "mount $ROOT_DEV failed"
fi

# State volumes. Everything writable lives here and nothing writable is
# on the measured surface, so these are mounted read-write and the root
# stays read-only for the whole life of the boot. Encryption of these
# volumes is not done here yet; they are plaintext.
#
# On an integrity-checked root they are also mounted noexec, nosuid and
# nodev. The launch measurement names the root and nothing on these
# volumes, and they outlive the boot: a binary, a setuid copy or a
# device node planted here by whoever had root last time would otherwise
# be there again after the reboot that re-measures the machine, and a
# verifier would see the same measurement. With these options the kernel
# refuses to execve or mmap-for-execution anything on them, ignores a set
# setuid bit, and refuses to open a device node on them. The plain layout
# keeps its writable root executable and is not changed.
#
# What this does NOT stop is a measured program reading a planted file as
# DATA -- a shell sourcing ~/.profile, a service reading its state. That
# limit is deliberate and stated wherever attestation is described: the
# state volumes survive a reboot, so a reboot is never a cleanup.
STATE_MOUNT_OPTS='rw'
if [ -n "$VERITY_ROOTHASH" ]; then
  STATE_MOUNT_OPTS='rw,nosuid,nodev,noexec'
fi
mount_state() {
  # mount_state <spec> <mountpoint under /newroot>
  [ -n "$1" ] || return 0
  _dev="$(await_device "$1" "state volume $2")"
  mkdir -p "/newroot$2"
  log "mounting $_dev at $2 ($STATE_MOUNT_OPTS)"
  if ! mount -t ext4 -o "$STATE_MOUNT_OPTS" "$_dev" "/newroot$2"; then
    rescue "mount $_dev at $2 failed"
  fi
}
mount_state "$STATE_VAR" /var
mount_state "$STATE_HOME" /home

# Kernel lockdown. The attested command line asks for
# `lockdown=integrity` (repro/uki.nim), which stops root from writing
# kernel memory (/dev/mem, /dev/kmem, /dev/port, MSRs), from resuming a
# hibernation image off the writable swap, and from loading a kexec
# image. The kernel IGNORES that argument when the lockdown LSM is not
# built in, and boots normally -- so a command line that asks for it is
# checked against what the kernel actually reports, and a kernel that
# did not honour it does not get to run an attested root.
LOCKDOWN_WANTED=''
for arg in $(cat /proc/cmdline); do
  case "$arg" in
    lockdown=*) LOCKDOWN_WANTED="${arg#lockdown=}" ;;
  esac
done
if [ -n "$LOCKDOWN_WANTED" ]; then
  mkdir -p /sys/kernel/security
  mount -t securityfs none /sys/kernel/security 2>/dev/null || true
  _lockdown="$(cat /sys/kernel/security/lockdown 2>/dev/null || true)"
  case "$_lockdown" in
    *"[$LOCKDOWN_WANTED]"*) log "kernel lockdown active: $_lockdown" ;;
    *) rescue "the command line asks for lockdown=$LOCKDOWN_WANTED but the kernel reports '${_lockdown:-no lockdown LSM}'" ;;
  esac
fi

# Close module loading and kexec on an integrity-checked root. Past this
# point a module could only come from somewhere the measurement does not
# cover, and a kexec image would replace the running kernel while the
# launch measurement still names this one. Under lockdown the ReproOS
# kernel already refuses every module, because it signs none and trusts
# no signing key -- so on an attested boot every driver is built in, and
# the `load_module` calls above find them in modules.builtin. Closing the
# loader here as well keeps that true whatever the kernel's signing
# configuration becomes. Both switches are one-way: nothing, root
# included, can turn them back on before the next boot.
close_one_way() {
  # close_one_way <sysctl path> <what it closes>
  if [ ! -e "$1" ]; then
    # Each file exists exactly when the kernel carries the facility:
    # kexec_load_disabled only with the kexec core (the ReproOS kernel
    # carries it for crash dumps but builds neither kexec syscall, so the
    # switch is still set), modules_disabled only with a module loader.
    # Absent is the stronger state, not a failure.
    log "$2: $1 absent, the kernel has no such facility"
    return 0
  fi
  if ! echo 1 > "$1" 2>/dev/null || [ "$(cat "$1")" != 1 ]; then
    rescue "could not close $2 ($1)"
  fi
  log "$2 closed ($1=1)"
}
if [ -n "$VERITY_ROOTHASH" ]; then
  close_one_way /proc/sys/kernel/modules_disabled 'module loading'
  close_one_way /proc/sys/kernel/kexec_load_disabled 'kexec'
fi

# Move /proc /sys /dev into the new root so the pivoted init can
# still read them.
mkdir -p /newroot/proc /newroot/sys /newroot/dev /newroot/run
mount --move /proc /newroot/proc
mount --move /sys  /newroot/sys
mount --move /dev  /newroot/dev
mount --move /run  /newroot/run

# Now hand off to the real init.
log "switch_root -> /sbin/init"
trap - EXIT
exec switch_root /newroot /sbin/init
rescue "switch_root returned - fatal"
