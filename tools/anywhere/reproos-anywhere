#!/usr/bin/env python3
"""ReproOS Anywhere: convert an existing Linux machine into ReproOS over SSH.

    reproos-anywhere preflight --enrollment E --config C [--inspection]
    reproos-anywhere plan      --name N --config C
    reproos-anywhere apply     --name N --acknowledge PLAN_ID
    reproos-anywhere resume    --name N --acknowledge PLAN_ID
    reproos-anywhere status    --name N
    reproos-anywhere verify    --name N

Common: --state DIR (controller state, default ./anywhere-state),
--payload DIR, --installer DIR, --kexec FILE, --layout-tool FILE.

`preflight` never writes the machine. `plan` writes only controller
state and prints the plan identity; nothing destructive happens until
`apply` is given exactly that identity. Exit status: 0 success,
2 refused (nothing changed), 3 blocked report, 1 failure.
"""

import argparse
import json
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))

from reproos_anywhere import canon  # noqa: E402
from reproos_anywhere import controller as c  # noqa: E402


def artifacts(args) -> c.Artifacts:
    return c.Artifacts(Path(args.payload), Path(args.installer), Path(args.kexec))


def print_report(report: dict) -> None:
    for check in report["checks"]:
        mark = {"pass": "ok  ", "fail": "FAIL", "requires": "REQ "}[check["verdict"]]
        print(f"  {mark} {check['id']}: {check['detail']}")
    print(f"verdict: {'BLOCKED' if report['blocked'] else 'compatible'}"
          f"{' (inspection only)' if report.get('inspection_only') else ''}; "
          f"conversion_qualified={str(report['conversion_qualified']).lower()}")
    print(f"report: {report.get('id', '')}")


def main() -> int:
    def common(default) -> argparse.ArgumentParser:
        # Accepted before or after the subcommand (`repro run anywhere-*`
        # puts the subcommand first).
        c = argparse.ArgumentParser(add_help=False)
        c.add_argument("--state", default="anywhere-state" if default is None else default)
        for opt in ("--payload", "--installer", "--kexec", "--layout-tool"):
            c.add_argument(opt, default=default)
        c.add_argument("--json", action="store_true", default=False if default is None else default,
                       help="print the result record as JSON")
        return c
    p = argparse.ArgumentParser(prog="reproos-anywhere", description=__doc__, parents=[common(None)],
                                formatter_class=argparse.RawDescriptionHelpFormatter)
    later = common(argparse.SUPPRESS)
    sub = p.add_subparsers(dest="cmd", required=True)
    _add = sub.add_parser
    sub.add_parser = lambda name, **kw: _add(name, parents=[later], **kw)
    pf = sub.add_parser("preflight")
    pf.add_argument("--enrollment", required=True)
    pf.add_argument("--config", required=True)
    pf.add_argument("--inspection", action="store_true")
    pl = sub.add_parser("plan")
    pl.add_argument("--name", required=True)
    pl.add_argument("--config", required=True)
    pl.add_argument("--takeover", choices=("auto", "kexec", "rescue-media"), default="auto",
                    help="auto prefers kexec; rescue-media keeps the source kernel out of the takeover")
    for name in ("apply", "resume", "recover"):
        a = sub.add_parser(name)
        a.add_argument("--name", required=True)
        a.add_argument("--acknowledge", required=True, metavar="PLAN_ID")
        a.add_argument("--max-rate", type=int, default=0, metavar="BYTES_PER_SECOND",
                       help="bound the payload transfer bandwidth (default: unbounded)")
        a.add_argument("--evidence-sink", metavar="SOCKET",
                       help="append-only evidence sink (reproos-anywhere-sink serve); every journal "
                            "record must be acknowledged there before the stage proceeds")
        a.add_argument("--clear-detection", action="store_true",
                       help="resume after an investigated detection halt")
        a.add_argument("--events", metavar="FILE",
                       help="append machine-readable progress events (JSON lines) and the verdict")
        if name == "resume":
            a.add_argument("--reformat", action="store_true",
                           help="after destroy only: format the failed install again and redo every "
                                "later stage (operator-confirmed; never touches the source, which is gone)")
        if name == "recover":
            a.add_argument("--rematerialize", action="store_true",
                           help="unpack the payload again over the installed root before repairing")
    st = sub.add_parser("status")
    st.add_argument("--name", required=True)
    lg = sub.add_parser("logs", help="the journal, and the tail of the rescue console")
    lg.add_argument("--name", required=True)
    lg.add_argument("--lines", type=int, default=60)
    sh_ = sub.add_parser("ssh", help="a shell on the INSTALLED system, with its pinned host key")
    sh_.add_argument("--name", required=True)
    sh_.add_argument("command", nargs="*")
    ct = sub.add_parser("contain", help="freeze, capture memory, power off and revoke (compromise)")
    ct.add_argument("--name", required=True)
    ct.add_argument("--evidence", required=True, metavar="DIR")
    iv = sub.add_parser("investigate", help="read-only report from the controller's evidence")
    iv.add_argument("--name", required=True)
    rp = sub.add_parser("replan", help="a new plan for a contained machine (rescue-media, fresh keys)")
    rp.add_argument("--name", required=True)
    ab = sub.add_parser("abort", help="roll back to the source system (only before destroy)")
    ab.add_argument("--name", required=True)
    bu = sub.add_parser("bundle", help="write a failure bundle without credentials")
    bu.add_argument("--name", required=True)
    bu.add_argument("--output", required=True)
    args = p.parse_args()
    state = Path(args.state)
    try:
        if args.cmd == "preflight":
            report = c.preflight(enrollment_path=Path(args.enrollment), config_path=Path(args.config),
                                 artifacts=artifacts(args), layout_tool=Path(args.layout_tool),
                                 state_root=state, inspection=args.inspection)
            print(json.dumps(report, indent=2, sort_keys=True)) if args.json else print_report(report)
            return 3 if report["blocked"] else 0
        if args.cmd == "plan":
            plan_id = c.make_plan(state_root=state, name=args.name, config_path=Path(args.config),
                                  artifacts=artifacts(args), takeover=args.takeover)
            plan = canon.read(state / args.name / "plan" / "plan.json")
            print(f"plan for {args.name}: target {plan['target']['serial']} "
                  f"({plan['storage']['device']}, {plan['target']['size_sectors']} sectors) "
                  f"layout {plan['storage']['layout']}; takeover {plan['takeover']}; payload {plan['payload']['kind']} "
                  f"qualified={str(plan['conversion_qualified']).lower()}")
            from reproos_anywhere import plan as plan_mod
            print(f"content identity {plan_mod.content_identity(plan)}")
            print("THIS PLAN DESTROYS EVERYTHING ON THAT DISK. To apply it, pass:")
            print(f"  --acknowledge {plan_id}")
            return 0
        if args.cmd in ("apply", "resume", "recover"):
            run = c.Apply(state_root=state, name=args.name, acknowledge=args.acknowledge,
                          artifacts=artifacts(args), resume=args.cmd != "apply",
                          max_rate=args.max_rate, evidence_sink=args.evidence_sink,
                          clear_detection=args.clear_detection,
                          reformat=getattr(args, "reformat", False),
                          events=Path(args.events) if args.events else None)
            proof = run.recover(args.rematerialize) if args.cmd == "recover" else run.run()
            print(json.dumps(proof, indent=2, sort_keys=True))
            return 0
        if args.cmd == "logs":
            from reproos_anywhere.journal import Journal
            sdir = state / args.name
            plan = canon.read(sdir / "plan" / "plan.json")
            for r in Journal(sdir / "journal.jsonl", canon.digest(plan)).records:
                print(f"{r['time']} {r['seq']:4} {r['stage']:20} {r['event']:9} "
                      f"{json.dumps(r['evidence'], sort_keys=True)[:160]}")
            enr = canon.read(sdir / "enrollment.json")
            from reproos_anywhere.rescue import adapter
            console = adapter(enr["rescue"]).console_since(0).splitlines()
            print(f"--- rescue console ({enr['rescue']['console_log']}), last {args.lines} lines ---")
            print("\n".join(console[-args.lines:]))
            return 0
        if args.cmd == "ssh":
            import os
            plan = canon.read(state / args.name / "plan" / "plan.json")
            enr = canon.read(state / args.name / "enrollment.json")
            st = c.State(state, args.name)
            session = c.Session(c.Endpoint(enr["ssh"]["address"], enr["ssh"]["port"],
                                           plan["configuration"]["user"],
                                           plan["identities"]["installed_host_key"],
                                           st.keys / "access_ed25519"), st.work)
            argv = session.argv(" ".join(args.command) if args.command else None)
            if not args.command:
                argv.remove("-T")
            os.execvp(argv[0], argv)
        if args.cmd in ("contain", "investigate", "replan"):
            from reproos_anywhere import recovery
            sdir = state / args.name
            if args.cmd == "contain":
                print(json.dumps(recovery.contain(sdir, Path(args.evidence)), indent=2, sort_keys=True))
            elif args.cmd == "investigate":
                print(json.dumps(recovery.investigate(sdir), indent=2, sort_keys=True))
            else:
                st = c.State(state, args.name)
                plan_id = recovery.replan(sdir, st.controller_key, st.controller_pub)
                print(f"  --acknowledge {plan_id}")
            return 0
        if args.cmd == "abort":
            from reproos_anywhere import recovery
            enr = canon.read(state / args.name / "enrollment.json")
            evidence = recovery.abort(state / args.name,
                                      lambda: c.source_session(enr, c.State(state, args.name)))
            print(json.dumps(evidence, indent=2, sort_keys=True))
            return 0
        if args.cmd == "bundle":
            from reproos_anywhere import recovery
            manifest = recovery.bundle(state / args.name, Path(args.output))
            print(f"bundle {args.output}: {len(manifest['files'])} files, plan {manifest['plan']}")
            return 0
        if args.cmd == "status":
            from reproos_anywhere.journal import Journal
            plan = canon.read(state / args.name / "plan" / "plan.json")
            j = Journal(state / args.name / "journal.jsonl", canon.digest(plan))
            print(json.dumps({"plan": canon.digest(plan), "completed": j.completed(),
                              "open": j.open_stage(), "records": len(j.records)}, indent=2))
            return 0
    except FileNotFoundError as error:
        print(f"REFUSED: {error.filename} does not exist (wrong --state or --name, or no plan yet)",
              file=sys.stderr)
        return 2
    except c.Refused as error:
        print(f"REFUSED: {error}", file=sys.stderr)
        return 2
    except (c.AnywhereError, c.RescueError) as error:
        print(f"FAILED: {error}", file=sys.stderr)
        return 1
    except Exception as error:  # noqa: BLE001 -- RecoveryError and friends, without a traceback
        if type(error).__name__ != "RecoveryError":
            raise
        print(f"FAILED: {error}", file=sys.stderr)
        return 1
    return 1


if __name__ == "__main__":
    sys.exit(main())
