{
  "id": "INSTALL",
  "cpuArch": "x86_64",
  "cpuMicrocode": "intel",
  "kernelModules": [],
  "loaderDevice": "/dev/vda",
  "filesystems": [],
  "graphicsDrivers": [],
  "audioCards": [],
  "disko": {
    "disks": {
      "main": {
        "device": "/dev/vda",
        "type": "gpt",
        "partitions": {
          "esp": {
            "type": "esp",
            "size": "512M",
            "bootable": true,
            "content": {
              "kind": "filesystem",
              "format": "vfat",
              "mountpoint": "/boot",
              "mountOptions": ["umask=0077"],
              "label": "ESP",
              "subvols": []
            }
          },
          "root": {
            "type": "linux",
            "size": "100%",
            "bootable": false,
            "content": {
              "kind": "filesystem",
              "format": "ext4",
              "mountpoint": "/",
              "mountOptions": ["defaults"],
              "label": "reproos-root",
              "subvols": []
            }
          }
        }
      }
    },
    "pools": []
  }
}
